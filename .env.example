# Non-secret identifiers. Secrets live in macOS Keychain (see README).
# Keychain entries:
#   cloudflare-api-token          → Cloudflare API token (account-scoped, cfat_...)
#   cloudflared-tunnel-hermes-b   → connector token from tunnel creation
#   hermes-eclaw-botsecret        → botSecret returned from /api/channel/bind

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID_ECLAWBOT=

HERMES_ECLAW_API_KEY_ID=
HERMES_ECLAW_DEVICE_ID=
HERMES_ECLAW_ENTITY_ID=
HERMES_ECLAW_PUBLIC_CODE=
HERMES_ECLAW_API_BASE=https://eclawbot.com
HERMES_ECLAW_CALLBACK_URL=https://hermes-b.eclawbot.com/webhooks/eclaw
HERMES_ECLAW_TUNNEL_ID=
HERMES_ECLAW_CALLBACK_TOKEN=

# PR-only file-edit flow (runtime secret; do not commit real value)
HERMES_GH_PAT=
HERMES_PR_ONLY_ENABLED=1
HERMES_PR_REPO_URL=https://github.com/HankHuang0516/EClaw.git
HERMES_PR_REPO_FULL_NAME=HankHuang0516/EClaw
HERMES_PR_BASE_BRANCH=main
HERMES_PR_BRANCH_PREFIX=hermes
HERMES_PR_REVIEWER=HankHuang0516

# H2 operational health-check (dry-run git probe + SLA event log)
HERMES_HEALTH_INTERVAL_SECS=21600
HERMES_HEALTH_DAEMON_URL=http://127.0.0.1:8645/health
HERMES_HEALTH_DAEMON_TIMEOUT_S=10
HERMES_HEALTH_REPO_URL=https://github.com/HankHuang0516/EClaw.git
HERMES_HEALTH_BRANCH=hermes-healthcheck
HERMES_HEALTH_PUSH_MODE=dry-run
HERMES_HEALTH_ALERT_AFTER_FAILURES=3
HERMES_HEALTH_COMMANDER_TARGET=2
HERMES_HEALTH_ALERT_ENABLED=1
HERMES_HEALTH_STATE_FILE=~/.hermes/eclaw-healthcheck-state.json
HERMES_HEALTH_EVENTS_FILE=~/.hermes/eclaw-healthcheck-events.jsonl
HERMES_HEALTH_SLA_WINDOW_SECS=604800
HERMES_HEALTH_SLA_TARGET_PCT=99.0
